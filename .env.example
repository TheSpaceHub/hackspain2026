# Prosper platform — from the registration desk
PROSPER_API_BASE_URL=https://hackspain.getprosperapp.com
PROSPER_API_KEY=pk-...

# Claude — used for both the call and the decider whenever this key is set.
# Without it the agent falls back to Cloudflare Workers AI.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_CALL_EFFORT=low       # a voice turn is judged on time-to-first-word
# ANTHROPIC_DECIDER_EFFORT=high   # the decider has the whole 30s window

# Cloudflare Workers AI — fallback LLM
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deepgram — STT (nova-3) + TTS (aura-2)
DEEPGRAM_API_KEY=

PORT=7860
LOG_DIR=./calls
