{
  "name": "el-turno",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:local": "PROSPER_API_BASE_URL=http://127.0.0.1:8787 tsx src/index.ts",
    "mock": "tsx mock/index.ts",
    "typecheck": "tsc --noEmit",
    "harness": "tsx test/fake-harness.ts",
    "harness:local": "MOCK_PROSPER_URL=http://127.0.0.1:8787 tsx test/fake-harness.ts",
    "test:audio": "tsx test/audio-output.test.ts",
    "bench": "tsx test/decider-bench.ts",
    "test:schema": "tsx test/schema.test.ts",
    "test:tools": "tsx test/tools.test.ts",
    "test:agent": "tsx test/agent-tools.test.ts",
    "test:extract": "tsx test/extract.test.ts",
    "test:recovery": "tsx test/recovery.test.ts",
    "test": "tsx test/schema.test.ts && tsx test/tools.test.ts && tsx test/agent-tools.test.ts && tsx test/extract.test.ts && tsx test/recovery.test.ts && tsx test/stream.test.ts && tsx test/audio-output.test.ts",
    "restart": "bash scripts/restart.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-anthropic": "1.9.0",
    "@livekit/agents-plugin-deepgram": "^1.9.0",
    "@livekit/agents-plugin-openai": "^1.9.0",
    "@livekit/agents-plugin-silero": "^1.9.0",
    "@livekit/rtc-node": "^1.0.0",
    "openai": "^6.49.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
